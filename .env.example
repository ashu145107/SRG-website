# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# The target backend API server for production hosting (e.g., https://srgapp.dindoripranit.org)
VITE_API_BASE_URL=

# Dev proxy target. Override when srgapp.dindoripranit.org is slow/unreachable
# or when testing against a local/UAT backend. Used by vite.config.ts (dev) and server.ts (start).
# VITE_PROXY_TARGET=https://srgapp.dindoripranit.org
# PROXY_TARGET=https://srgapp.dindoripranit.org
